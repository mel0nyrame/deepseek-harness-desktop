{
  "name": "@dsh-desktop/connection",
  "version": "0.1.0",
  "description": "Desktop IPC connection provider: implements the existing Client/Host connection contracts over a validated, context-isolated preload bridge with no general Node.js or Electron access in the renderer.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./lib/client.js"
    },
    "./carrier": {
      "types": "./src/carrier.ts",
      "default": "./lib/carrier.js"
    },
    "./preload": {
      "types": "./src/preload.ts",
      "default": "./lib/preload.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.8"
  },
  "dsh": {
    "client": {
      "inject": [],
      "external": [
        "@deepseek-ai/dsh-client-connection/client"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
