{
  "name": "@dsh-desktop/native",
  "version": "0.1.0",
  "description": "Native capability providers for DSH Desktop: directory selection and path opening as desktop Cordis providers over the official Service Definition contracts, with reverse requests through the DSH child boundary and Electron main as the operating-system adapter.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./gateway": {
      "types": "./src/gateway.ts",
      "default": "./lib/gateway.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-directory-picker": "0.1.0-rc.8",
    "@dsh-desktop/connection": "workspace:*"
  }
}
