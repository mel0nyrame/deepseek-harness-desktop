{
  "name": "@dsh-desktop/ui",
  "version": "0.1.0",
  "description": "UI contributions for DSH Desktop: client renderer registrations, theme tokens, layout contributions, and slots through documented client extension points.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/browser-client.ts",
      "default": "./lib/client.js"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "default": "./lib/assets.js"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./lib/contract.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./lib/runtime.js"
    },
    "./surface": {
      "types": "./src/surface.ts",
      "default": "./lib/surface.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-client-module.ts --id @dsh-desktop/ui --entry packages/ui/src/browser-client.ts --output packages/ui/lib/client.js --external react --external @deepseek-ai/dsh-client-ui-primitives"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-modules": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-web-frontend": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "@types/react": "18.3.31",
    "react-dom": "18.3.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
