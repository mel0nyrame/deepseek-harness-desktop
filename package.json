{
  "name": "@dsh-desktop/root",
  "version": "0.1.0",
  "description": "DSH Desktop product workspace: an independent Electron desktop application assembled from the exact published DeepSeek Harness runtime and desktop-owned Cordis plugins.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint . --ignore-pattern 'upstream/**'",
    "test": "pnpm run build && vitest run",
    "test:layout": "vitest run tests/repository-layout.test.ts",
    "runtime:assemble": "pnpm run build && node scripts/assemble-runtime.ts",
    "test:runtime": "vitest run tests/runtime-assembly.test.ts",
    "package": "node scripts/package-desktop.ts",
    "test:package": "vitest run tests/desktop-package.test.ts tests/desktop-packaged.e2e.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "oxlint": "1.76.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
