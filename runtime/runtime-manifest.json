        "lib/bin.js"
      ]
    }
  },
  "platformDependencies": {
    "node-pty": {
      "version": "1.2.0-beta.15",
      "targets": {
        "darwin-arm64": {
          "package": "node-pty",
          "artifacts": [
            "prebuilds/darwin-arm64/pty.node",
            "prebuilds/darwin-arm64/spawn-helper"
          ]
        },
        "darwin-x64": {
          "package": "node-pty",
          "artifacts": [
            "prebuilds/darwin-x64/pty.node",
            "prebuilds/darwin-x64/spawn-helper"
          ]
        },
        "linux-x64": {
          "package": "node-pty",
          "artifacts": [
            "prebuilds/linux-x64/pty.node"
          ]
        }
      }
    },
    "koffi": {
      "version": "3.1.0",
      "targets": {
        "darwin-arm64": {
          "package": "@koromix/koffi-darwin-arm64",
          "artifacts": [
            "darwin_arm64/koffi.node"
          ]
        },
        "darwin-x64": {
          "package": "@koromix/koffi-darwin-x64",
          "artifacts": [
            "darwin_x64/koffi.node"
          ]
        },
        "linux-x64": {
          "package": "@koromix/koffi-linux-x64",
          "artifacts": [
            "linux_x64/koffi.node"
          ]
        }
      }
    }
  },
  "patches": [
    {
      "package": "node-pty",
      "version": "1.2.0-beta.15",
      "file": "patches/node-pty@1.2.0-beta.15.patch",
      "sha256": "b40ae545608897914bd25fb009c97eeac478c34e8a910298ddcb01b746534bb0",
      "rationale": "Allow the embedded Electron carrier to supply the spawn helper from an explicit filesystem path.",
