          "package": "node-pty",
          "artifacts": [
            "prebuilds/linux-x64/pty.node"
          ]
        }
      }
    },
    "koffi": {
      "version": "3.1.0",
      "targets": {
        "darwin-arm64": {
          "package": "@koromix/koffi-darwin-arm64",
          "artifacts": [
            "darwin_arm64/koffi.node"
          ]
        },
        "darwin-x64": {
          "package": "@koromix/koffi-darwin-x64",
