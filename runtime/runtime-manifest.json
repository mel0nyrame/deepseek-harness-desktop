      "removeWhen": "An official node-pty release supports a non-sibling spawn-helper path.",
      "tests": [
        "tests/runtime-assembly.test.ts"
      ]
    }
  ],
  "build": {
    "packageManager": "pnpm@11.7.0",
    "lockfile": "pnpm-lock.yaml",
