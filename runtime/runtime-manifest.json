          ]
        }
      }
    }
  },
  "patches": [
    {
      "package": "node-pty",
      "version": "1.2.0-beta.15",
      "file": "patches/node-pty@1.2.0-beta.15.patch",
      "sha256": "b40ae545608897914bd25fb009c97eeac478c34e8a910298ddcb01b746534bb0",
      "rationale": "Allow the embedded Electron carrier to supply the spawn helper from an explicit filesystem path.",
      "upstream": "https://github.com/microsoft/node-pty/issues/826",
      "removeWhen": "An official node-pty release supports a non-sibling spawn-helper path.",
      "tests": [
        "tests/runtime-assembly.test.ts"
      ]
    },
    {
      "package": "@deepseek-ai/dsh-client-connection",
      "version": "0.1.0-rc.8",
      "file": "patches/@deepseek-ai__dsh-client-connection@0.1.0-rc.8.patch",
      "sha256": "348ced8d8f44995c9da47db1b058f5d93e1761e0f3e6b36dab8d138a12773fc0",
      "rationale": "Expose transport-neutral Client factories and a Host channel registrar so the desktop provider can implement the published connection contracts without WebServer.",
      "upstream": "https://github.com/deepseek-ai/deepseek-harness/tree/141eb6fef83422698aef7a981029e843e8161534/packages/client/connection/src",
      "removeWhen": "An exact published @deepseek-ai/dsh-client-connection release exposes equivalent Client transport factories and a Host channel registrar.",
      "tests": [
        "tests/connection-carrier.test.ts",
        "tests/connection-host.test.ts",
        "tests/connection-composition.test.ts"
      ]
    }
  ],
  "build": {
    "packageManager": "pnpm@11.7.0",
    "lockfile": "pnpm-lock.yaml",
    "assemblyScript": "scripts/assemble-runtime.ts",
    "output": ".artifacts/runtime",
    "electron": {
      "version": "43.4.0",
      "runAsNode": true
