{
  "schemaVersion": 1,
  "dshVersion": "0.1.0-rc.8",
  "upstreamCommit": "141eb6fef83422698aef7a981029e843e8161534",
  "entryPackages": {
    "@dsh-desktop/shell": {
      "version": "0.1.0",
      "entrypoints": [
        "lib/main.js",
        "lib/preload.cjs",
        "lib/renderer.js",
        "renderer.html"
      ]
    },
    "@dsh-desktop/bundle": {
      "version": "0.1.0",
      "entrypoints": [
        "lib/index.js",
        "cordis.patch.yml"
      ]
    },
    "@deepseek-ai/dsh": {
      "version": "0.1.0-rc.8",
      "entrypoints": [
        "lib/bin.js"
      ]
    }
  },
  "platformDependencies": {
    "node-pty": {
      "version": "1.2.0-beta.15",
      "targets": {
        "darwin-arm64": {
          "package": "node-pty",
          "artifacts": [
            "prebuilds/darwin-arm64/pty.node",
            "prebuilds/darwin-arm64/spawn-helper"
          ]
        },
        "darwin-x64": {
          "package": "node-pty",
          "artifacts": [
            "prebuilds/darwin-x64/pty.node",
            "prebuilds/darwin-x64/spawn-helper"
          ]
        },
        "linux-x64": {
          "package": "node-pty",
          "artifacts": [
            "prebuilds/linux-x64/pty.node"
          ]
        }
      }
    },
    "koffi": {
      "version": "3.1.0",
      "targets": {
        "darwin-arm64": {
          "package": "@koromix/koffi-darwin-arm64",
          "artifacts": [
            "darwin_arm64/koffi.node"
          ]
        },
        "darwin-x64": {
          "package": "@koromix/koffi-darwin-x64",
          "artifacts": [
            "darwin_x64/koffi.node"
          ]
        },
        "linux-x64": {
          "package": "@koromix/koffi-linux-x64",
          "artifacts": [
            "linux_x64/koffi.node"
          ]
        }
      }
    }
  },
  "patches": [
    {
      "package": "node-pty",
      "version": "1.2.0-beta.15",
      "file": "patches/node-pty@1.2.0-beta.15.patch",
      "sha256": "b40ae545608897914bd25fb009c97eeac478c34e8a910298ddcb01b746534bb0",
      "rationale": "Allow the embedded Electron carrier to supply the spawn helper from an explicit filesystem path.",
      "upstream": "https://github.com/microsoft/node-pty/issues/826",
      "removeWhen": "An official node-pty release supports a non-sibling spawn-helper path.",
      "tests": [
        "tests/runtime-assembly.test.ts"
      ]
    },
    {
      "package": "@deepseek-ai/dsh-client-connection",
      "version": "0.1.0-rc.8",
      "file": "patches/@deepseek-ai__dsh-client-connection@0.1.0-rc.8.patch",
      "sha256": "348ced8d8f44995c9da47db1b058f5d93e1761e0f3e6b36dab8d138a12773fc0",
      "rationale": "Expose transport-neutral Client factories and a Host channel registrar so the desktop provider can implement the published connection contracts without WebServer.",
      "upstream": "https://github.com/deepseek-ai/deepseek-harness/tree/141eb6fef83422698aef7a981029e843e8161534/packages/client/connection/src",
      "removeWhen": "An exact published @deepseek-ai/dsh-client-connection release exposes equivalent Client transport factories and a Host channel registrar.",
      "tests": [
        "tests/connection-carrier.test.ts",
        "tests/connection-host.test.ts",
        "tests/connection-composition.test.ts"
      ]
    },
    {
      "package": "@deepseek-ai/dsh-client-modules",
      "version": "0.1.0-rc.8",
      "file": "patches/@deepseek-ai__dsh-client-modules@0.1.0-rc.8.patch",
      "sha256": "07af454e8431f012e10c8aa58659263dd8f3e5566b952847c6c3ed5cb80409c2",
      "rationale": "Keep the official Client graph and bundle resolver available to the desktop carrier when no WebServer provider is mounted.",
      "upstream": "https://github.com/deepseek-ai/deepseek-harness/tree/141eb6fef83422698aef7a981029e843e8161534/packages/client/modules/src",
      "removeWhen": "An exact published @deepseek-ai/dsh-client-modules release treats WebServer as an optional carrier.",
      "tests": [
        "tests/desktop-client-modules.test.ts",
        "tests/ui-assets.test.ts"
      ]
    },
    {
      "package": "@deepseek-ai/dsh-client-ui-layout",
      "version": "0.1.0-rc.8",
      "file": "patches/@deepseek-ai__dsh-client-ui-layout@0.1.0-rc.8.patch",
      "sha256": "155fb0639e530b16f8dbc24b39d96c20faa484f9ded9aa46e18bf6d98c51cc72",
      "rationale": "Let the desktop shell close the sidebar to zero width, expose stable surface state, and restore its last dragged width without replacing the published layout module.",
      "upstream": "https://github.com/deepseek-ai/deepseek-harness/tree/141eb6fef83422698aef7a981029e843e8161534/packages/client/ui/layout/src",
      "removeWhen": "An exact published @deepseek-ai/dsh-client-ui-layout release exposes zero-width collapse, the last expanded width, and stable desktop surface state.",
      "tests": [
        "tests/desktop-layout-patch.test.ts",
        "tests/desktop-ui-client.test.ts"
      ]
    }
  ],
  "build": {
    "packageManager": "pnpm@11.7.0",
    "lockfile": "pnpm-lock.yaml",
    "assemblyScript": "scripts/assemble-runtime.ts",
    "output": ".artifacts/runtime",
    "electron": {
      "version": "43.4.0",
      "runAsNode": true
    },
    "lockfileSha256": "cf6d513d481d2821a7a343f59154e05b36b89842b5e00c8dd3b79f8e845df7ea"
  }
}
