{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron development shell for the bundled DeepSeek Harness runtime",
  "version": "0.1.0-rc.5",
  "type": "module",
  "main": "lib/main.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
